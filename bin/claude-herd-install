#!/usr/bin/env bash

# Wire the tmux-claude-herd status hooks into ~/.claude/settings.json.
#
# Same problem and same shape as bin/claude-statusline-restore: the config that makes
# this work lives in a file Claude Code owns and rewrites, and which is NOT tracked in
# this repo. This script is the source of truth for it. It is idempotent - run it any
# time the hooks go missing:
#   - symlinks ~/.claude/herd-hook -> repo/bin/claude-herd-hook
#   - merges the herd hook entries into ~/.claude/settings.json, touching nothing else
#     (any hook you added yourself, on the same events, is preserved)
#
#   claude-herd-install            install / repair
#   claude-herd-install --remove   take the herd hooks back out
#
# Without these hooks the popup still works - it falls back to diffing each agent's
# screen and marks those statuses with a * to show they are inferred. The hooks are what
# turn "the screen is moving" into "waiting on 2 subagents".

set -euo pipefail

# Resolve the real repo dir even when invoked via the ~/bin symlink.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="$(cd "$script_dir/.." && pwd -P)"

claude_dir="$HOME/.claude"
settings="$claude_dir/settings.json"
hook_link="$claude_dir/herd-hook"
herd_dir="$claude_dir/herd"

# Canonical hook config - the single source of truth. Event names verified against
# https://code.claude.com/docs/en/hooks; Notification matchers filter on notification
# type, with multiple types separated by '|'.
read -r -d '' additions <<'JSON' || true
{
  "UserPromptSubmit": [
    { "hooks": [ { "type": "command", "command": "~/.claude/herd-hook working" } ] }
  ],
  "PostToolUse": [
    { "hooks": [ { "type": "command", "command": "~/.claude/herd-hook tool-done" } ] }
  ],
  "SubagentStart": [
    { "hooks": [ { "type": "command", "command": "~/.claude/herd-hook subagent-start" } ] }
  ],
  "SubagentStop": [
    { "hooks": [ { "type": "command", "command": "~/.claude/herd-hook subagent-stop" } ] }
  ],
  "Notification": [
    {
      "matcher": "permission_prompt|agent_needs_input",
      "hooks": [ { "type": "command", "command": "~/.claude/herd-hook needs-you" } ]
    },
    {
      "matcher": "idle_prompt",
      "hooks": [ { "type": "command", "command": "~/.claude/herd-hook idle" } ]
    }
  ],
  "Stop": [
    { "hooks": [ { "type": "command", "command": "~/.claude/herd-hook idle" } ] }
  ],
  "SessionEnd": [
    { "hooks": [ { "type": "command", "command": "~/.claude/herd-hook clear" } ] }
  ]
}
JSON

mode="install"
[[ "${1:-}" == "--remove" ]] && mode="remove"

if ! command -v jq >/dev/null 2>&1; then
    echo "  ERROR: jq not found - cannot edit settings.json safely." >&2
    exit 1
fi

mkdir -p "$claude_dir" "$herd_dir"

# link_file <target> <link>: point <link> at <target>, backing up anything real.
link_file() {
    local target="$1" link="$2"
    if [[ -L "$link" && "$(readlink "$link")" == "$target" ]]; then
        echo "  ok: $link already links to $target"
        return 0
    fi
    if [[ -e "$link" || -L "$link" ]]; then
        local bak="$link.bak.$(date +%Y%m%d%H%M%S)"
        echo "  backing up existing $link -> $bak"
        mv "$link" "$bak"
    fi
    ln -s "$target" "$link"
    echo "  linked: $link -> $target"
}

# Start from {} if settings.json is missing/empty; back it up if it's invalid JSON.
if [[ ! -s "$settings" ]]; then
    echo '{}' > "$settings"
    chmod 600 "$settings"
elif ! jq empty "$settings" >/dev/null 2>&1; then
    bak="$settings.bak.$(date +%Y%m%d%H%M%S)"
    echo "  WARNING: $settings is not valid JSON - backing up to $bak and starting fresh" >&2
    mv "$settings" "$bak"
    echo '{}' > "$settings"
    chmod 600 "$settings"
fi

# Strip only OUR handlers out of each matcher group, then drop groups left with none.
# Editing at handler level (not group level) is what makes this safe to re-run next to
# hooks you configured yourself on the same events.
read -r -d '' jq_clean <<'JQ' || true
def clean:
  map(.hooks = ((.hooks // []) | map(select((.command // "") | contains("herd-hook") | not))))
  | map(select((.hooks | length) > 0));
JQ

tmp="$(mktemp)"
if [[ "$mode" == "install" ]]; then
    echo "Installing Claude herd hooks from $repo_dir"
    link_file "$repo_dir/bin/claude-herd-hook" "$hook_link"

    jq --argjson add "$additions" "
      $jq_clean
      .hooks = (
        reduce (\$add | keys_unsorted[]) as \$e ((.hooks // {});
          .[\$e] = (((.[\$e] // []) | clean) + \$add[\$e]))
      )
    " "$settings" > "$tmp"
    mv "$tmp" "$settings"
    chmod 600 "$settings"
    echo "  merged herd hooks into $settings"
    echo "  state dir: $herd_dir"
    echo "Done. Already-running Claude sessions pick the hooks up on their next turn."
else
    echo "Removing Claude herd hooks"
    jq "
      $jq_clean
      .hooks = ((.hooks // {}) | with_entries(.value |= clean) | with_entries(select((.value | length) > 0)))
      | if (.hooks | length) == 0 then del(.hooks) else . end
    " "$settings" > "$tmp"
    mv "$tmp" "$settings"
    chmod 600 "$settings"
    rm -f "$hook_link"
    echo "  removed herd hooks from $settings and unlinked $hook_link"
    echo "Done. The popup still works; statuses fall back to inferred (*) ones."
fi
